{
  "name": "ftp-deploy-mcp",
  "version": "0.2.0",
  "mcpName": "io.github.alebgl77/ftp-deploy-mcp",
  "description": "Deploy, inspect and transfer files over FTP/FTPS/SFTP with local confinement and verified staging. / Déployer, inspecter et transférer des fichiers FTP/FTPS/SFTP avec confinement local et promotion vérifiée.",
  "type": "module",
  "license": "MIT",
  "author": "Alexandre Beguel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alebgl77/ftp-deploy-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/alebgl77/ftp-deploy-mcp/issues"
  },
  "homepage": "https://github.com/alebgl77/ftp-deploy-mcp#readme",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "ftp-deploy-mcp": "src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "node test/smoke.test.js && node --test test/transport-qualification.js && node --test test/cli-i18n.js && node --test test/error-contract.js test/zero-cancellation.js && node --test test/resource-bounds.js && node --test test/state/*.test.mjs && node --test test/workflow/*.test.mjs",
    "test:transports": "node --test test/transport-qualification.js",
    "setup": "node src/index.js setup",
    "doctor": "node src/index.js doctor",
    "test:contract": "node --test test/error-contract.js test/zero-cancellation.js",
    "eval:scripted": "node scripts/evaluation/run.mjs --repo . --locale both --verify-runtime-locale true --ci true",
    "test:eval-runner": "node --test test/evaluation-runner.mjs",
    "test:bounds": "node --test test/resource-bounds.js",
    "test:state": "node --test test/state/*.test.mjs",
    "test:workflow": "node --test test/workflow/*.test.mjs"
  },
  "files": [
    "src",
    "docs",
    "evaluations",
    "README.md",
    "README.fr.md",
    "ftp-servers.example.json",
    "LICENSE",
    "LICENSE.fr.md",
    "install.cmd",
    "install.sh",
    "CONTRIBUTING.md",
    "CONTRIBUTING.fr.md",
    "CHANGELOG.md",
    "CHANGELOG.fr.md",
    "SECURITY.md",
    "SECURITY.fr.md",
    "server.json"
  ],
  "keywords": [
    "mcp",
    "ftp",
    "sftp",
    "ftps",
    "deploy",
    "filezilla",
    "model-context-protocol",
    "claude",
    "cursor",
    "windsurf"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "basic-ftp": "^6.0.1",
    "picomatch": "^4",
    "ssh2-sftp-client": "^12.1.1",
    "zod": "^3.25",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@electerm/ftp-srv": "^1.0.5",
    "ssh2": "^1.17.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
