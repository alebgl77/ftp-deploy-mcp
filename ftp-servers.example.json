{
  "defaultServer": "prod",
  "servers": {
    "prod": {
      "protocol": "sftp",
      "host": "ssh.example.com",
      "port": 22,
      "user": "deploy",
      "privateKeyPath": "~/.ssh/id_ed25519",
      "localRoot": "/home/alice/projects/site",
      "root": "/var/www/site",
      "hostKeySha256": "SHA256:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
      "readOnly": false
    },
    "ovh": {
      "protocol": "ftps",
      "host": "ftp.cluster0xx.hosting.ovh.net",
      "port": 21,
      "user": "mysite",
      "password": "${ENV:OVH_FTP_PASSWORD}",
      "localRoot": "/home/alice/projects/site",
      "root": "/",
      "insecureTLS": false,
      "readOnly": false
    }
  }
}
